# Replicore Environment Configuration

# Cluster Mode: "local" (in-process SQLite multi-node simulation) or "postgres" (multi-container PostgreSQL)
REPLICORE_CLUSTER_MODE=local

# Primary Node Configuration
PRIMARY_DB_URL=postgresql+psycopg://replicore_user:replicore_pass@localhost:5432/replicore_db
PRIMARY_SQLITE_PATH=./data/primary.db

# Replica 1 Configuration
REPLICA_1_DB_URL=postgresql+psycopg://replicore_user:replicore_pass@localhost:5433/replicore_db
REPLICA_1_SQLITE_PATH=./data/replica_1.db

# Replica 2 Configuration
REPLICA_2_DB_URL=postgresql+psycopg://replicore_user:replicore_pass@localhost:5434/replicore_db
REPLICA_2_SQLITE_PATH=./data/replica_2.db

# Simulation Settings
REPLICA_1_DELAY_MS=500
REPLICA_2_DELAY_MS=2000
REPLICATION_POLL_INTERVAL_MS=50
DEFAULT_REPLICATION_DELAY_MS=2000
HEARTBEAT_INTERVAL_SECONDS=2
MISSED_HEARTBEAT_THRESHOLD=3
AUTO_FAILOVER_ENABLED=true
API_PORT=8000

# Deployment Variables (Render Backend / Vercel Frontend)
# Port dynamically provided by Render at runtime ($PORT)
PORT=8000

# Allowed CORS origins for FastAPI backend (comma-separated or '*' for wildcard)
# Set to your production Vercel frontend URL and local dev origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Frontend API Base URL (used by Vite / Vercel)
# In production on Vercel: set to your Render backend service URL (e.g., https://your-backend.onrender.com)
# In local development: leave empty to route via Vite proxy (/api -> http://localhost:8000)
VITE_API_BASE_URL=
